# Frontend (.env.local / Vercel project env). Browser-safe: only the public Convex URL.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Used by `npx convex dev` locally (written for you by `npx convex dev --configure`).
CONVEX_DEPLOYMENT=dev:your-deployment

# ── Backend secrets live in Convex, NOT here ──
# Set with: npx convex env set NAME value   (add --prod for production)
#   VAANI_API_KEY              Vaani workspace API key
#   VAANI_CALLER_AGENT_ID      Raksha (caller) agent UUID
#   VAANI_RESPONDER_AGENT_ID   Police-desk agent UUID
#   TEST_USER_PHONE            Person-in-danger test phone, +91XXXXXXXXXX
#   TEST_RESPONDER_PHONE       Police stand-in phone (unset = browser police desk at /police)
#   TEST_ALLOWED_PHONES        Comma-separated allowlist of every number that may be called
#   LIVE_CALLS_ENABLED         "true" to place real Vaani calls
#   DEMO_SAMPLE_DATA           "true" for sample name/phone/location fallbacks
#   TEST_USER_NAME             Optional display name for the police briefing
#   SOS_PHRASES                Optional comma-separated custom trigger phrases
#   JWT_PRIVATE_KEY, JWKS, SITE_URL   Convex Auth keys (scripts/setup-demo-auth.ts creates them)
